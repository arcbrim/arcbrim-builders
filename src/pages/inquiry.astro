---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadPage } from "../lib/pageContent";

const { data, html } = loadPage("inquiry");
---
<BaseLayout title={`${data.title ?? "Inquiry"} | ARCBRIM BUILDERS`} current="inquiry">
  <section class="section">
    <h1>{data.title ?? "Inquiry"}</h1>
    <p class="muted">{data.lede ?? ""}</p>
    <div class="callout" set:html={html}></div>
    <div class="actions">
      <a class="button" href="/inquiry">Begin an inquiry</a>
    </div>
  </section>
</BaseLayout>
