---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadPage } from "../lib/pageContent";

const { data, html } = loadPage("home");
---
<BaseLayout title={data.title ?? "ARCBRIM BUILDERS"} current="home">
  <section class="section">
    <h1>{data.lede ?? ""}</h1>
    <div class="callout" set:html={html}></div>
    <div class="actions">
      <a class="button" href="/inquiry">Begin an inquiry</a>
    </div>
  </section>
</BaseLayout>
