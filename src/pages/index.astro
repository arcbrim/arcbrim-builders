---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadPage } from "../lib/pageContent";

const { data, html } = loadPage("home");
---

<BaseLayout title={data.title ?? "ARCBRIM BUILDERS"} current="home">

  <!-- Modal -->
  <div class="modal-overlay" id="modal-overlay" role="dialog" aria-modal="true" aria-label="Build season announcement">
    <div class="modal">
      <button class="modal-close" id="modal-close" aria-label="Close">✕</button>
      <p class="modal-label">2026 Build Season</p>
      <h2 class="modal-headline">Now scheduling three portfolio projects for the 2026 build season.</h2>
      <p class="modal-body">Selected projects receive priority scheduling, dedicated project management, and full documentation for the Arcbrim Builders portfolio.</p>
      <a href="/inquiry" class="modal-cta">Begin an Inquiry</a>
    </div>
  </div>

  <section class="section">
    <div class="stack">
      <h1>{data.title ?? "ARCBRIM BUILDERS"}</h1>
      <p class="lede">{data.lede ?? ""}</p>

      <img
        src="/assets/img/hero-builders.jpg"
        alt="Modern, purpose-built residential garage environment"
        class="hero-image"
        loading="eager"
        decoding="async"
      />

      <div class="callout">
        <div class="prose" set:html={html}></div>

        <div class="actions">
          <a class="cta" href="/inquiry">Begin an inquiry</a>
        </div>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  .modal-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: rgba(26, 26, 24, 0.75);
    z-index: 200;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .modal-overlay.is-open {
    display: flex;
  }

  .modal {
    background: #F5F3EF;
    max-width: 480px;
    width: 100%;
    padding: clamp(2rem, 5vw, 3rem);
    position: relative;
    border-top: 2px solid #2B4899;
  }

  .modal-close {
    position: absolute;
    top: 1rem;
    right: 1rem;
    background: transparent;
    border: none;
    font-size: 0.9rem;
    color: #8A8A85;
    cursor: pointer;
    padding: 0.25rem 0.5rem;
    line-height: 1;
  }

  .modal-close:hover {
    color: #1A1A18;
  }

  .modal-label {
    font-size: 0.65rem;
    font-weight: 400;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: #2B4899;
    margin-bottom: 1rem;
  }

  .modal-headline {
    font-size: 1.375rem;
    font-weight: 400;
    color: #1A1A18;
    line-height: 1.3;
    margin-bottom: 1rem;
  }

  .modal-body {
    font-size: 0.875rem;
    color: #3D3D3A;
    line-height: 1.7;
    margin-bottom: 1.75rem;
    max-width: none;
  }

  .modal-cta {
    display: inline-block;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #2B4899;
    border-bottom: 1px solid #2B4899;
    padding-bottom: 2px;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .modal-cta:hover {
    opacity: 0.7;
  }
</style>

<script>
  (() => {
    if (sessionStorage.getItem('modal-dismissed')) return;
    setTimeout(() => {
      const overlay = document.getElementById('modal-overlay');
      if (overlay) overlay.classList.add('is-open');
    }, 2000);

    document.getElementById('modal-close')?.addEventListener('click', () => {
      document.getElementById('modal-overlay')?.classList.remove('is-open');
      sessionStorage.setItem('modal-dismissed', '1');
    });

    document.getElementById('modal-overlay')?.addEventListener('click', (e) => {
      if (e.target === e.currentTarget) {
        (e.currentTarget as HTMLElement).classList.remove('is-open');
        sessionStorage.setItem('modal-dismissed', '1');
      }
    });
  })();
</script>