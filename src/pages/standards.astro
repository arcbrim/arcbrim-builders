---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadPage } from "../lib/pageContent";

const { data, html } = loadPage("standards");
---
<BaseLayout title={`${data.title ?? "Standards"} | ARCBRIM BUILDERS`} current="standards">
  <section class="section">
    <div class="stack">
      <h1>{data.title ?? "Standards"}</h1>
      <p class="lede">{data.lede ?? ""}</p>

      <div class="callout">
        <div class="prose" set:html={html}></div>
      
        <div class="actions">
          <a class="cta" href="/inquiry">Begin an inquiry</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
