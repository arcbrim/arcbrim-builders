---
import BaseLayout from "../layouts/BaseLayout.astro";
import { loadPage } from "../lib/pageContent";

const { data, html } = loadPage("home");
---

<BaseLayout title={data.title ?? "ARCBRIM BUILDERS"} current="home">
  <section class="section">
    <div class="stack">
      <h1>{data.title ?? "ARCBRIM BUILDERS"}</h1>
      <p class="lede">{data.lede ?? ""}</p>

      <img
        src="/assets/img/hero-builders.jpg"
        alt="Modern, purpose-built residential garage environment"
        class="hero-image"
        loading="eager"
        decoding="async"
      />

      <div class="callout">
        <div class="prose" set:html={html}></div>

        <div class="actions">
          <a class="cta" href="/inquiry">Begin an inquiry</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

